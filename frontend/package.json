{
  "name": "motion-analysis-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && cap sync",
    "android:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-android-server.ps1",
    "android:debug": "powershell -ExecutionPolicy Bypass -File scripts/build-android-debug.ps1",
    "android:release": "powershell -ExecutionPolicy Bypass -File scripts/build-android-release.ps1",
    "check:course": "node --test scripts/product-ia.test.mjs scripts/responsive-layout.test.mjs scripts/navigation-cleanup.test.mjs scripts/shoes-page-ui.test.mjs scripts/pwa-app.test.mjs scripts/capacitor-app.test.mjs scripts/launch-experience.test.mjs scripts/android-branding.test.mjs scripts/server-integration.test.mjs scripts/server-health-ui.test.mjs scripts/coach-feedback-ui.test.mjs scripts/ui-smoke-script.test.mjs && node scripts/course-delivery-check.mjs",
    "test:product": "node --test scripts/product-ia.test.mjs",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "ui:smoke:auth": "node scripts/ui-smoke.mjs --register",
    "smoke": "node scripts/smoke-check.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@lucide/vue": "^1.17.0",
    "axios": "^1.17.0",
    "echarts": "^5.5.1",
    "leaflet": "^1.9.4",
    "vant": "^4.10.0",
    "vue": "^3.5.35",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vite": "^6.0.7"
  }
}
