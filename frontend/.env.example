# Local backend development.
VITE_API_BASE_URL=http://localhost:8089/api

# Server integration example:
# VITE_API_BASE_URL=http://SERVER_PUBLIC_IP/api
# Android native APK uses an absolute server API because /api is not valid
# inside the Capacitor WebView origin. The build script can read this from
# D:\MotionCare\服务器密匙\公网ip.txt automatically.
VITE_NATIVE_API_BASE_URL=http://SERVER_PUBLIC_IP/api

# Production behind Nginx, same origin:
# VITE_API_BASE_URL=/api
