# Production build example for Nginx + Vue + Express.
# Copy values into the server build environment or a local .env.production.local file.
# Do not commit real server credentials, database accounts, or private deployment values.

VITE_API_BASE_URL=/api

# Android native APK must point to the public server API explicitly.
# Prefer HTTPS after a domain/certificate is configured.
VITE_NATIVE_API_BASE_URL=http://SERVER_PUBLIC_IP/api
